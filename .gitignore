# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# CMake / CLion build output
cmake-build-*/
build/
CMakeCache.txt
CMakeFiles/

# JetBrains IDE (keep shared run configurations in .run)
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/

# Visual Studio
.vs/
*.suo
*.user

# Configuration backups written by the administrator editor
*.json.bak

# Print test results (regenerated by build_and_release.ps1; the documents in
# TestPrint/ itself are kept)
TestPrint/Results/

# Token used by build_and_release.ps1 (prefer $env:GITHUB_TOKEN)
.github_token

# Local container settings with credentials
deploy/docker/.env.local
deploy/docker/config/WolsCAPrintService.json
