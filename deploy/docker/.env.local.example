# Local test settings for the container - copy to .env.local and fill in.
#
#   Copy-Item deploy/docker/.env.local.example deploy/docker/.env.local
#
# .env.local is in .gitignore, so real credentials never reach GitHub. Only these
# connection details are taken from the environment; the rest of the
# configuration stays exactly as in WolsCAPrintService.json.
WOLSCA_MQTT_BROKER=192.168.101.240
WOLSCA_MQTT_PREFIX=wols_ca/print_service
WOLSCA_MQTT_USER=wolsca_mqtt
WOLSCA_MQTT_PASSWORD=change-me
# Unlocks the Administrator card in the web app of the container.
WOLSCA_ADMIN_TOKEN=localtest
TZ=Europe/Amsterdam
