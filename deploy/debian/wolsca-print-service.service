[Unit]
Description=Wols CA Print Service
Documentation=https://github.com/Wols-CA/Wols_CA_PrintService
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
# The service configures CUPS queues, writes /etc/wolsca and manages spool
# directories, so it runs as root. 'lp' is added as a supplementary group so
# everything cups-pdf drops stays readable and removable.
# install.sh rewrites User=/Group= when it installs with another service user.
User=root
Group=root
SupplementaryGroups=lp
Environment=PYTHONUNBUFFERED=1
Environment=WOLSCA_CONFIG=/etc/wolsca/WolsCAPrintService.json
WorkingDirectory=/opt/wolsca-print-service
ExecStart=/opt/wolsca-print-service/venv/bin/python /opt/wolsca-print-service/main.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening (the service only needs its own spool dirs and outbound network).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/spool/wolsca /etc/wolsca

[Install]
WantedBy=multi-user.target